{
  "gateway": {
    "port": 18789,
    "bind": "lan",
    "auth": { "mode": "token" }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "skipBootstrap": true,
      "sandbox": { "mode": "off" }
    }
  },
  "tools": {
    "allow": ["appli-tools"],
    "deny": [
      "exec",
      "write",
      "edit",
      "apply_patch",
      "browser",
      "nodes",
      "process",
      "terminal",
      "code_execution",
      "gateway"
    ]
  },
  "plugins": {
    "load": {
      "extraDirs": ["/home/node/.openclaw/extensions"]
    }
  }
}
