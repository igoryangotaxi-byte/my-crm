{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/sales-operation/cron/task-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sales-operation/cron/discovery-tick",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/ai/cron/tick",
      "schedule": "30 5 * * *"
    }
  ]
}
